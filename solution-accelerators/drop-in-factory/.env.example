# Copy to .env and fill in. Do not commit .env.
# Every npm run script reads this file itself. A variable that is already set
# in the environment wins over its line here, so leave a line empty when the
# value is already an environment variable (a Cursor cloud agent's Secrets).

# GitHub: contents, issues and pull requests write on factory.yaml repo. gh reads this name too.
GH_TOKEN=
# Cursor Cloud Agents API key for the account that launches the role agents.
CURSOR_API_KEY=
# Optional Team Admin API key. Without it invoice cost is not emitted.
CURSOR_ADMIN_API_KEY=

# Who Foreman's own GitHub comments post as: github.identity in factory.yaml.
# app (recommended): the factory GitHub App's id and its private key (PEM; a
# one-line value with \n for the line breaks works).
SA_GH_APP_ID=
SA_GH_APP_PRIVATE_KEY=
# bot-user: a token for the bot user's own GitHub account.
SA_GH_BOT_TOKEN=
# personal needs nothing more: comments post as the owner of GH_TOKEN.

# Relative to this folder.
SA_FACTORY_CONFIG=factory.yaml

# The collector from setup/compose.yaml (docker compose -f setup/compose.yaml up -d). The doctor fails
# while this is empty; Foreman sends no metrics without it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Dashboard (dashboard: in factory.yaml). The secret signs every push; make it
# with openssl rand -hex 32 and give the dashboard the same value. npm run dev
# starts the dashboard at this URL with this secret, so the doctor can probe it.
SA_PORTAL_URL=http://127.0.0.1:8787
SA_PORTAL_INGEST_SECRET=

# Required when factory.yaml has a slack block.
FOREMAN_SLACK_BOT_TOKEN=
FOREMAN_SLACK_APP_TOKEN=

# Verification (setup/verify-factory). Unset means the defaults.
# SA_DOCTOR_PORTS=8787,8790
# SA_VERIFY_EVIDENCE=.factory/verify
# SA_VERIFY_PID_FILE=.factory/verify/pids.json
# SA_VERIFY_LEDGER=setup/verdicts/ledger.jsonl
# SA_DEPLOYS_LEDGER=setup/verdicts/deploys.jsonl
# SA_VERIFY_DRIVE=1
# SA_VERIFY_REPO=owner/name
# SA_EXPECTED_TEAM_ID=
# SA_EXPECTED_TEAM_NAME=
# The hosted release and secrets checks are off until this is 1. They read the deployment; they do not deploy.
# SA_VERIFY_HOSTED=
# SA_DEPLOYMENT_SLUG=foreman
