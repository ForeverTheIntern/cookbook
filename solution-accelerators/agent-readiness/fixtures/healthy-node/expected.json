      "name": "default",
      "level": 2,
      "levels": {
        "healthy-node": {
          "first_pr": 2,
          "bug_fixes": 2,
          "features": 2
        }
      },
      "repoLevels": {
        "first_pr": 2,
        "bug_fixes": 2,
        "features": 2,
        "repo_wide": 2
