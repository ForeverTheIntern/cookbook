{
  "goal": "bug_fixes",
  "purpose": "The install needs a private registry token: it fails without --registry-env and passes with it.",
  "runs": [
    {
      "name": "no token",
      "level": 0,
      "levels": {
        "needs-private-registry": {
          "first_pr": 0,
          "bug_fixes": 0,
          "features": 0
        }
      },
      "repoLevels": {
        "first_pr": 0,
        "bug_fixes": 0,
        "features": 0,
        "repo_wide": 0
      },
      "top": [
        "clean.install:repo"
      ],
      "startNow": null,
      "noBlocker": false,
      "safety": "pass",
      "diagnosis": "registry credentials not provided"
    },
    {
      "name": "with --registry-env NPM_TOKEN",
      "registryEnv": {
        "NPM_TOKEN": "fixture-token-not-a-secret"
      },
      "level": 2,
      "levels": {
        "needs-private-registry": {
          "first_pr": 2,
          "bug_fixes": 2,
          "features": 2
        }
      },
      "repoLevels": {
        "first_pr": 2,
        "bug_fixes": 2,
        "features": 2,
        "repo_wide": 2
      },
      "top": [
        "targets:bug_fixes"
      ],
      "startNow": "delegate:bug_fixes:needs-private-registry",
      "noBlocker": true,
      "safety": "pass"
    }
  ]
}
