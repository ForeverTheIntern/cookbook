  "runs": [
    {
      "name": "default",
      "level": 1,
      "levels": {
        "python-unpinned": {
          "first_pr": 2,
          "bug_fixes": 2,
          "features": 2
        }
      },
      "repoLevels": {
        "first_pr": 2,
        "bug_fixes": 2,
        "features": 2,
        "repo_wide": 1
      },
      "top": [
        "lockfile:repo",
        "toolchain:repo"
      ],
      "startNow": null,
      "noBlocker": false,
      "safety": "pass"
    }
  ]
}
